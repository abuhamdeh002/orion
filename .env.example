# Copy this file to .env and fill in values you use.
# Never commit a real .env file.

# ollama (local first, free cloud keys as fallback) | openai
AI_PROVIDER=ollama
AI_MODEL=qwen3:8b
# Local model to use when AI_PROVIDER=openai
OLLAMA_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

OLLAMA_BASE_URL=http://127.0.0.1:11434

WEATHER_API_KEY=
WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Free cloud models (https://console.groq.com/keys, https://aistudio.google.com/apikey).
# Leave blank to stay on local Ollama.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
PRIVATE_MODE=false
ORION_HOST=127.0.0.1
ORION_PORT=8765
ORION_PIN=

# kokoro (local British voice, default) | edge (neural, needs internet) | pyttsx3 (system voice) | none
TTS_PROVIDER=kokoro
# Optional: ELEVENLABS_API_KEY and ELEVENLABS_VOICE_ID make ElevenLabs the first voice.
# speech_recognition (local faster-whisper; Google only for push-to-talk if local fails) | none
STT_PROVIDER=speech_recognition

LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=60
CONTEXT_MAX_MESSAGES=20

# The address your phone opens. Blank means this PC's Tailscale name (https://<pc>.ts.net),
# after running 'tailscale serve --bg 8765' once.
ORION_PUBLIC_URL=

# Phone relay. Leave blank to stay on the local network only.
ORION_RELAY_URL=
ORION_ACCOUNT_ID=
ORION_ACCOUNT_TOKEN=
# The phone's relay token (role=phone), from the same portal page as the PC token.
ORION_PHONE_TOKEN=
